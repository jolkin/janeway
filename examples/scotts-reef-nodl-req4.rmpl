;;; -*- mode: common-lisp; -*-
;; Generated by scripts/tpnr-bench/gen_reef.py  (Scott's Reef pSTN scenario)
;; sites=5 req=4 boats=2 deadline=0 max_prob_violation=0.1
;; move~N(50,5) observe~N(30,5)  -- probabilistic durations => pSTN.
(defpackage #:cogrob)
(in-package #:cogrob)

(defclass glider ()
  ((location    :initarg :location :initform "start" :type (member nil "start" "science-1" "science-2" "science-3" "science-4" "science-5") :accessor location)
   (observations :initarg :observations :initform 0 :type integer :accessor observations)
   (in-transit  :initarg :in-transit :initform nil :type boolean :accessor in-transit)))

(define-control-program move (glider to)
  (declare (primitive)
           (requires (and (over :all (odo:equal (in-transit glider) t))
                          (at :start (odo:equal (in-transit glider) nil))))
           (effect (and (at :start (odo:equal (in-transit glider) t))
                        (at :end (odo:equal (in-transit glider) nil))
                        (at :end (odo:equal (location glider) to))))
           (duration (probabilistic :distribution '(normal :mean 50 :stdev 5))
                     :contingent t)))

(define-control-program observe (glider loc)
  (declare (primitive)
           (requires (and (over :all (odo:equal (in-transit glider) nil))
                          (over :all (odo:equal (location glider) loc))))
           (effect (at :end (odo:+ (observations glider) 1)))
           (duration (probabilistic :distribution '(normal :mean 30 :stdev 5))
                     :contingent t)))

(define-control-program skip ()
  (declare (primitive)
           (duration (simple :lower-bound 0))))

(define-control-program sample-location (glider loc)
  (simple-choice (list
    (sequence (:slack t)
      (move glider loc)
      (observe glider loc))
    (skip))))

(define-control-program science-req (glider)
  (declare (primitive)
           (requires (at :start (odo:ge (observations glider) 4)))
           (duration (simple :lower-bound 0))))

(define-control-program boat-1-science-1 (glider)
  (declare (primitive)
           (requires (over :all (odo:not (odo:equal (location glider) "science-1"))))
           (duration (probabilistic :distribution '(normal :mean 100 :stdev 10))
                     :contingent t)))

(define-control-program boat-1-science-2 (glider)
  (declare (primitive)
           (requires (over :all (odo:not (odo:equal (location glider) "science-2"))))
           (duration (probabilistic :distribution '(normal :mean 100 :stdev 10))
                     :contingent t)))

(define-control-program boat-1-science-3 (glider)
  (declare (primitive)
           (requires (over :all (odo:not (odo:equal (location glider) "science-3"))))
           (duration (probabilistic :distribution '(normal :mean 100 :stdev 10))
                     :contingent t)))

(define-control-program boat-schedule-1 (glider)
    (sequence (:slack :end)
        (boat-1-science-1 glider)
        (boat-1-science-2 glider)
        (boat-1-science-3 glider)))

(define-control-program boat-2-science-4 (glider)
  (declare (primitive)
           (requires (over :all (odo:not (odo:equal (location glider) "science-1"))))
           (duration (probabilistic :distribution '(normal :mean 120 :stdev 10))
                     :contingent t)))

(define-control-program boat-2-science-3 (glider)
  (declare (primitive)
           (requires (over :all (odo:not (odo:equal (location glider) "science-2"))))
           (duration (probabilistic :distribution '(normal :mean 55 :stdev 10))
                     :contingent t)))

(define-control-program boat-2-science-5 (glider)
  (declare (primitive)
           (requires (over :all (odo:not (odo:equal (location glider) "science-3"))))
           (duration (probabilistic :distribution '(normal :mean 125 :stdev 10))
                     :contingent t)))

(define-control-program boat-schedule-2 (glider)
    (sequence (:slack :end)
        (boat-2-science-4 glider)
        (boat-2-science-3 glider)
        (boat-2-science-5 glider)))

(define-control-program glider-mission (glider)
  (sequence (:slack t)
    (parallel (:slack t)
        (sample-location glider "science-1")
        (sample-location glider "science-2")
        (sample-location glider "science-3")
        (sample-location glider "science-4")
        (sample-location glider "science-5"))
    (science-req glider)))

(define-control-program main (glider)
    (with-chance-constraint (:max-prob-violation 0.1)
            (parallel (:slack :end)
                (glider-mission glider)
                (boat-schedule-1 glider)
                (boat-schedule-2 glider)
            )
    ))

(define-initial-state start-state ()
  (:objects
   (glider0 (make-instance 'glider :state-space-name "glider0"))))

(define-model test-model "test-dave-multi.yaml")
